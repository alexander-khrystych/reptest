{
  // The relay Worker — a separate compilation from the app (Workers runtime, not the DOM).
  // Runtime + Env types come from ../worker-configuration.d.ts, produced by `wrangler types`
  // (regenerated by the `typecheck:party` script). Verified with `pnpm typecheck:party`;
  // wrangler transpiles this on dev/deploy.
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true
  },
  "include": ["server.ts", "../src/session/protocol.ts", "../worker-configuration.d.ts"]
}
