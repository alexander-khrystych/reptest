{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The real-time relay for session sharing. Deployed separately from the Pages frontend
  // (`pnpm party:deploy`); the app connects to it via VITE_PARTYKIT_HOST. Runs $0 on the
  // Workers Free plan — one SQLite-backed Durable Object per room, with hibernation.
  "name": "reptest-relay",
  "main": "party/server.ts",
  "compatibility_date": "2026-08-01",
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "Session", "class_name": "Session" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session"] }]
}
